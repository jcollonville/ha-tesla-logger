{
  "config": {
    "step": {
      "user": {
        "title": "Connect to tesla-logger",
        "description": "The server is read-only. Create an API token (tl_...) on its status page. The token stays on Home Assistant and is not sent to the browser.",
        "data": {
          "url": "Server URL",
          "token": "API token"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate",
        "description": "The API token for {name} was rejected. Paste a new token from the tesla-logger status page.",
        "data": {
          "token": "API token"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the server",
      "invalid_auth": "Invalid API token",
      "invalid_url": "Enter an http or https URL without a password",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This server is already configured",
      "reauth_successful": "Authentication updated"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Scan settings",
        "description": "The WebSocket pushes live state. REST polling fills in fields the socket does not send, and it is the fallback when the socket is down.",
        "data": {
          "scan_interval": "REST poll interval",
          "websocket": "Enable live WebSocket"
        }
      }
    }
  },
